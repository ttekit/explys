# ----- PostgreSQL (Explys DB) -----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=exply
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Server
PORT=4200
NODE_ENV=development
# When `1` / `true` / `yes`: legacy dev flag (align with frontend `DEV_MODE`). Email verification is optional for app access; users may browse without confirming.
DEV_MODE=1

# ----- Redis (sessions + OAuth cookie flow) -----
# URL for ioredis when SESSION_STORE=redis (default). Start Redis: from repo root `docker compose up -d redis` (see backend/docker-compose.yml).
# REDIS_URL=redis://127.0.0.1:6379
# If you do not run Redis locally, use in-memory sessions and catalog cache (dev only — not for production):
# SESSION_STORE=memory

# Public SPA origin (OAuth redirect after login, transactional email links, email-confirm redirect).
FRONTEND_URL=http://localhost:5173/
# Canonical public marketing origin for sitemap.xml (defaults to FRONTEND_URL).
# PUBLIC_SITE_URL=https://explys.com
# Append public catalog lesson URLs to sitemap when true (Path B content SEO).
# SEO_SITEMAP_INCLUDE_PUBLIC_CATALOG=false
# Public URL of this API (OAuth redirect_uri root). In production set explicitly (e.g. https://api.example.com).
# When unset in development, defaults to http://localhost:${PORT}.
# PUBLIC_API_URL=http://localhost:4200

# Browser origins allowed for CORS (comma-separated). When NODE_ENV=production this must be set.
# Include dev ports, production domains, and (optional) raw IP smoke tests, e.g.:
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://explys.com,https://www.explys.com,http://91.232.30.6,http://91.232.30.6:5173
# When unset in development, any origin is reflected (permissive for local testing).
#
# Max JSON / urlencoded body size for Nest (e.g. profile PATCH with large studying-plan JSON).
# If the browser reports "blocked by CORS" with status 413, nginx/Cloudflare may be rejecting the
# body before Nest — raise client_max_body_size (nginx) / proxy limits to match or exceed this.
# Example snippet: backend/nginx/explys-reverse-proxy.example.conf
HTTP_JSON_BODY_LIMIT=500mb

# JWT (required)
JWT_SECRET="change-me-jwt-secret"

# API integration token: required on EVERY request when NODE_ENV=production (header: x-api-token).
# In development, the global API token check is disabled.
# Must match frontend `VITE_API_TOKEN` for admin/dashboard API calls from the SPA.
API_TOKEN="change-me-shared-api-token-replace-me"

# Rate limiting (global ThrottlerGuard in AppModule; opt-in buckets on routes)
# Default: permissive for normal API traffic (catalog, profile, heartbeats).
DEFAULT_RATE_TTL=60
DEFAULT_RATE_LIMIT=1000
# Upload routes (POST /contents/teacher/upload, create, :id/episodes) — ttl in seconds
UPLOAD_RATE_TTL=60
UPLOAD_RATE_LIMIT=10
# Auth endpoints (login, 2FA, email OTP) — ttl in milliseconds
AUTH_RATE_TTL=60000
AUTH_RATE_LIMIT=10

# Max video upload size for POST/PATCH /contents (bytes). Default in code: 512 MiB if unset.
# Must stay ≤ nginx client_max_body_size. Was 100 MiB — raise here if you lowered nginx only.
# CONTENT_VIDEO_MAX_FILE_BYTES=536870912

# Paid access (Stripe) is enforced globally on learner JWT routes when NODE_ENV=production only.
# In development / non-production environments, subscription checks are skipped (same pattern as API token).
# Email verification is optional (users get a JWT without confirming). Set DISABLE_EMAIL=true to skip sending confirmation mail.
# To disable enforcement in production (emergency): true | 1 | yes
# SKIP_SUBSCRIPTION_ENFORCEMENT=true

# SPA origin for iframe postMessage and production CSP when frame-ancestors env is unset.
# FRONTEND_ORIGIN=https://app.example.com

# Optional: restrict who may embed test iframes (CSP frame-ancestors).
# In production without this set, defaults to 'self' (+ FRONTEND_ORIGIN when set), not *.
# Example: COMPREHENSION_TEST_FRAME_ANCESTORS="'self' https://app.example.com"
COMPREHENSION_TEST_FRAME_ANCESTORS=
# PLACEMENT_TEST_FRAME_ANCESTORS=

# ----- Email (ZeptoMail / SMTP) -----
# Mail sends when SMTP_* is set. Set DISABLE_EMAIL=true only to turn it off.
# DISABLE_EMAIL=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=test
SMTP_PASSWORD="password"
SMTP_FROM=noreply@explys.com

# Gemini API
GEMINI_MODEL="gemini-3.1-flash-lite-preview"
GEMINI_API_KEY="your-gemini-api-key"    

# Deepgram captions (Listen API). Flow: FFmpeg extracts 16 kHz mono PCM WAV locally, then Listen POST (`audio/wav`).
DEEPGRAM_API_KEY=
# Default model for WAV transcription: nova-3. Override only if Deepgram directs (e.g. nova-3-general).
# DEEPGRAM_TRANSCRIBE_MODEL=nova-3

# FFmpeg for caption pipeline (bundled `@ffmpeg-installer/ffmpeg` unless set).
# FFMPEG_PATH=

# AWS S3
AWS_REGION="eu-central-1"
AWS_S3_REGION="eu-central-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_S3_BUCKET_NAME="your-bucket-name"

# ----- Stripe (billing) -----
# Secret key — server only (never commit). Test: sk_test_..., live: sk_live_...
STRIPE_SECRET_KEY=
# Publishable key — safe in the browser. Test: pk_test_..., live: pk_live_...
# Also exposed via GET /billing/stripe-publishable-key (optional; SPA can use VITE_STRIPE_PUBLISHABLE_KEY instead).
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (whsec_...) from Stripe Dashboard or `stripe listen` for POST /billing/webhook.
# Enable events: checkout.session.completed, checkout.session.async_payment_succeeded,
# customer.subscription.created, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# Subscription price IDs (recurring monthly prices in Stripe).
STRIPE_PRICE_ID_LIGHT=
STRIPE_PRICE_ID_SMART=
STRIPE_PRICE_ID_FAMILY=
# After Checkout Stripe redirects the browser here (SPA). Must match cancel URL host/port if local.
# Server appends session_id={CHECKOUT_SESSION_ID} & checkout=success. If SUCCESS points at /subscribe it is rewritten to /catalog on the cancel URL origin.
# Leave STRIPE_CHECKOUT_SUCCESS_URL empty to use {same origin as CANCEL_URL}/catalog
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/catalog
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/subscribe

# Cloudflare ReCaptcha keys

CLOUDFLARE_TURNSTILE_SITE_KEY=your key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your key


# DEV_MODE=0 in production. Email confirmation is optional; DISABLE_EMAIL=false sends confirmation codes.
DEV_MODE=0
DISABLE_EMAIL=false

# Optional: copy avatars from production into local DB
# PROD_SSH_HOST=91.232.30.6
# PROD_SSH_USER=root
# PROD_SSH_PASSWORD=
# PROD_POSTGRES_CONTAINER=exply-postgres
# PROD_DB_NAME=eng_curses
# Or without SSH: PROD_API_URL=https://api.explys.com
# npm run copy:avatars-prod

# Cookie signing secret (used for OAuth / Sessions if any)
COOKIES_SECRET="change-me-cookies-secret"
SESSION_SECRET="change-me-session-secret"
SESSION_NAME="explys_session"
SESSION_MAX_AGE="7d"
SESSION_HTTP_ONLY="true"
SESSION_SECURE="false"
SESSION_FOLDER="explys_sessions:"
