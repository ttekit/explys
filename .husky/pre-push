#!/usr/bin/env sh

echo "Running pre-push hook (via husky)..."

# Prevent pushing directly to the 'product' branch
current_branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$current_branch" = "product" ]; then
  echo ""
  echo "🚫 ERROR: Direct pushes to the 'product' branch are forbidden."
  echo "👉 Please push your changes to a feature branch and create a Pull Request."
  echo ""
  exit 1
fi

while read local_ref local_sha remote_ref remote_sha
do
  if [ "$remote_ref" = "refs/heads/product" ]; then
    echo ""
    echo "🚫 ERROR: Direct pushes to the 'product' branch on the remote are forbidden."
    echo "👉 Please push to a different branch."
    echo ""
    exit 1
  fi
done

echo "Pre-push hook passed!"
